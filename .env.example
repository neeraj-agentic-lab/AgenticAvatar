APP_ENV=development

# ── Web app ────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ── Gateway ────────────────────────────────────────────────────────────────────
GATEWAY_PUBLIC_URL=http://localhost:8000
REDIS_URL=redis://localhost:6380/0

# ── Salesforce Agentforce ──────────────────────────────────────────────────────
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_AGENT_ID=
SALESFORCE_AGENT_API_VERSION=v1

# ── Conversation mode ──────────────────────────────────────────────────────────
# standard          → separate STT provider + Agentforce Agent API
# agentforce_voice  → Salesforce handles STT + agent in one API
CONVERSATION_MODE=standard

# ── STT — used only when CONVERSATION_MODE=standard ───────────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# ── TTS — Cartesia ─────────────────────────────────────────────────────────────
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-english

# ── LiveKit ────────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://YOUR_LAN_IP:7880   # auto-updated by scripts/start-dev.sh
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── Avatar worker ──────────────────────────────────────────────────────────────
AVATAR_WORKER_TARGET=localhost:50051
AVATAR_MODEL_PATH=/models/ditto
AVATAR_ASSET_BUCKET=
MOCK_MODE=true

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
