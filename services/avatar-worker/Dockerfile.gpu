FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies
RUN apt-get update && apt-get install -y \
    wget git git-lfs ffmpeg \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    build-essential python3.10 python3.10-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.10 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# Install Miniconda
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/mc.sh && \
    bash /tmp/mc.sh -b -p /opt/conda && rm /tmp/mc.sh
ENV PATH=/opt/conda/bin:$PATH

# Create conda env with just the critical packages from conda channels
# (PyTorch 2.5.1 + CUDA 12.1 + cuDNN 9.1 — Ditto's exact tested combination)
RUN conda create -n ditto python=3.10 -y && \
    conda install -n ditto -y -c pytorch -c nvidia \
      pytorch=2.5.1 torchvision=0.20.1 torchaudio=2.5.1 \
      pytorch-cuda=12.1 \
      cudnn=9.1 \
    && conda clean -afy

# Activate ditto env by putting it first in PATH and symlinking
ENV PATH=/opt/conda/envs/ditto/bin:/opt/conda/bin:$PATH
ENV CONDA_DEFAULT_ENV=ditto
# Ensure the ditto env Python is used exclusively
RUN ln -sf /opt/conda/envs/ditto/bin/python /usr/local/bin/python && \
    ln -sf /opt/conda/envs/ditto/bin/python /usr/local/bin/python3

# Install remaining pip dependencies matching Ditto's environment.yaml
RUN pip install --no-cache-dir \
    numpy==2.0.1 \
    tensorrt==8.6.1 tensorrt-bindings==8.6.1 tensorrt-libs==8.6.1 \
    cuda-python==12.1.0 \
    librosa==0.10.2.post1 \
    opencv-python-headless==4.10.0.84 \
    imageio==2.36.1 imageio-ffmpeg==0.5.1 \
    scikit-image==0.25.0 \
    scipy==1.15.0 soundfile==0.13.0 \
    tqdm colored filetype cython \
    polygraphy \
    onnxruntime-gpu \
    livekit livekit-api \
    grpcio==1.67.0 grpcio-tools==1.67.0 \
    "protobuf>=3.20,<5"

# Clone Ditto
RUN git clone https://github.com/antgroup/ditto-talkinghead.git /ditto && \
    sed -i 's/np\.atan2/np.arctan2/g' /ditto/core/aux_models/mediapipe_landmark478.py && \
    cd /ditto && python -c "import pyximport; pyximport.install(); from core.utils.blend import blend_images_cy" 2>/dev/null || true

# Generate gRPC stubs
COPY packages/contracts/avatar.proto /tmp/avatar.proto
RUN mkdir -p /proto_gen && python -m grpc_tools.protoc \
    -I /tmp \
    --python_out=/proto_gen \
    --grpc_python_out=/proto_gen \
    /tmp/avatar.proto

COPY services/avatar-worker/server_gpu.py /app/server.py
COPY services/avatar-worker/start_gpu_worker.py /app/start.py

ENV PYTHONPATH="/proto_gen:/ditto:${PYTHONPATH}"
ENV DITTO_CHECKPOINTS=/models/ditto/checkpoints/ditto_trt_T4
ENV DITTO_CFG=/models/ditto/checkpoints/ditto_cfg/v0.4_hubert_cfg_trt_t4.pkl
ENV AVATAR_SOURCE_IMAGE=/models/ditto/portrait.jpg
ENV CUDA_VISIBLE_DEVICES=0

EXPOSE 50051
CMD ["python", "/app/start.py"]
