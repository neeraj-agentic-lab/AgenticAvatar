FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    git \
    git-lfs \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda (matches Ditto's conda environment)
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh

ENV PATH=/opt/conda/bin:$PATH

# Copy Ditto's exact environment.yaml
# This is the tested, working combination: PyTorch 2.5.1 + cuDNN 9.1 + TRT 8.6.1
COPY services/avatar-worker/ditto_environment.yaml /tmp/ditto_environment.yaml

# Create the ditto conda environment from the exact environment.yaml
# This replicates Ditto's own tested setup
RUN conda env create -f /tmp/ditto_environment.yaml && \
    conda clean -afy

# Set ditto conda env as default Python
ENV PATH=/opt/conda/envs/ditto/bin:$PATH
ENV CONDA_DEFAULT_ENV=ditto

# Add our extra packages (grpcio, livekit) to the ditto env
RUN pip install --no-cache-dir \
    grpcio==1.67.0 \
    grpcio-tools==1.67.0 \
    livekit \
    livekit-api \
    onnxruntime-gpu

# Clone Ditto repo
RUN git clone https://github.com/antgroup/ditto-talkinghead.git /ditto && \
    sed -i 's/np\.atan2/np.arctan2/g' /ditto/core/aux_models/mediapipe_landmark478.py

# Generate gRPC stubs using ditto env's Python
COPY packages/contracts/avatar.proto /tmp/avatar.proto
RUN mkdir -p /proto_gen && python -m grpc_tools.protoc \
    -I /tmp \
    --python_out=/proto_gen \
    --grpc_python_out=/proto_gen \
    /tmp/avatar.proto

# Copy GPU server and launcher
COPY services/avatar-worker/server_gpu.py /app/server.py
COPY services/avatar-worker/start_gpu_worker.py /app/start.py

ENV PYTHONPATH="/proto_gen:/ditto:${PYTHONPATH}"
ENV MOCK_MODE=false
ENV DITTO_CHECKPOINTS=/models/ditto/checkpoints/ditto_trt_T4
ENV DITTO_CFG=/models/ditto/checkpoints/ditto_cfg/v0.4_hubert_cfg_trt_t4.pkl
ENV AVATAR_SOURCE_IMAGE=/models/ditto/portrait.jpg
ENV CUDA_VISIBLE_DEVICES=0
# TRT 8.6.1 library paths for the ditto conda env
ENV LD_LIBRARY_PATH=/opt/conda/envs/ditto/lib/python3.10/site-packages/tensorrt_libs:${LD_LIBRARY_PATH}

EXPOSE 50051
CMD ["python", "/app/start.py"]
